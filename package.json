{
  "name": "sporto-poc-backend",
  "version": "1.0.0",
  "description": "POC backend for football player scouting reports",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:fill-gaps": "node scripts/fill-gaps.js",
    "db:enrich": "node scripts/enrich.js",
    "db:embed": "node scripts/embed.js",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js && node scripts/fill-gaps.js && node scripts/enrich.js && node scripts/embed.js",
    "db:synth": "node scripts/synth.js --players 300000 --reports 1000000",
    "db:synth:clean": "node scripts/synth.js --clean",
    "pretest": "node scripts/test-db.js",
    "test": "node --test tests/*.test.js",
    "eval:chat": "node scripts/eval-chat.js"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}
