# ---- Server / database ----
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sporto_poc
# Read-only role used for every chatbot query (created by `npm run db:migrate`). Falls back to DATABASE_URL,
# but chatbot connections are forced read-only with a statement timeout either way.
CHAT_DATABASE_URL=postgres://chat_reader:chat_reader@localhost:5432/sporto_poc
CHAT_STATEMENT_TIMEOUT_MS=8000

# ---- Chatbot: LLM provider ----
# openai (default) | mock (offline/tests; answers only the questions in tests/fixtures/specs.json)
LLM_PROVIDER=openai
# REQUIRED for the chatbot with LLM_PROVIDER=openai
OPENAI_API_KEY=
# Model that plans the question (route + query spec) and checks meaning-search matches. Small + fast is best.
OPENAI_MODEL=gpt-4o-mini
# Optional: model for written answers (general chat, profiles, comparisons, comment judgements); defaults to OPENAI_MODEL
CHAT_COMMENT_MODEL=
# Optional: custom endpoint (Azure OpenAI / proxy / OpenAI-compatible server)
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1

# ---- Chatbot: meaning search (embeddings) ----
# openai (default) | mock (offline tests only – lexical, no real meaning)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Background worker in the API process that embeds new report sentences (false = run `npm run db:embed` yourself)
EMBEDDINGS_WORKER=true
EMBEDDING_INTERVAL_MS=5000
# How many closest sentences are considered per meaning question, and the minimum similarity to consider
CHAT_MEANING_CANDIDATES=150
CHAT_MEANING_FLOOR=0.4
# true = an LLM confirms which candidate sentences really express the concept (much better precision)
CHAT_MEANING_VERIFY=true

# ---- Chatbot: behaviour ----
# false = never send scout text to the LLM (comment judgements, profiles' written summary, meaning-search check)
CHAT_ALLOW_COMMENT_LLM=true
# Cache of question -> plan (saves the LLM call for repeated questions)
CHAT_SPEC_CACHE_TTL_SECONDS=3600
# Cache of plan -> database result (cleared automatically on any data write)
CHAT_RESULT_CACHE_TTL_SECONDS=60

# ---- Geo (distance questions like "within 1 hour from Ikast") ----
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# Nominatim requires an identifying User-Agent; put your contact email/app name
GEO_USER_AGENT=sporto-poc-backend/1.0 (you@example.com)

# ---- Tests ----
# npm test creates/uses this database on the same server (your data is never touched)
TEST_DATABASE_NAME=sporto_poc_test

# ---- Hosted deployment (Render + Neon) – see DEPLOY.md ----
# Shared key the frontend must send (x-access-key). Empty = no protection (local development).
ACCESS_KEY=
# Allowed frontend origins, comma separated (e.g. https://sporto.vercel.app). Empty = any origin.
CORS_ORIGIN=
# Password for the chatbot's read-only database role, set by `npm run db:migrate`
CHAT_READER_PASSWORD=
